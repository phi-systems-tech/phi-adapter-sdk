#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build/deb

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/usr

# The binary boundary is checked at every package build: the library against
# the committed baseline (abi/, see scripts/abi-check.sh). Until the first
# release of the d-pointer shape there is no baseline and the check says so.
override_dh_auto_test:
	dh_auto_test
	dh_auto_build -- abi-check

# Every adapter built against this library gets "phi-adapter-sdk (>= <this
# version>)": a newer adapter cannot land on an older library. A symbols file
# would say it per symbol, but a C++ symbol table is churn (templates,
# instantiations, mangled names) and abidiff already watches the ABI itself.
override_dh_makeshlibs:
	dh_makeshlibs -V
